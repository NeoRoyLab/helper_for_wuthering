{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/NeoRoyLab/helper_for_wuthering/main/schema/character.schema.json",
  "title": "Wuthering Waves character core record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "rarity",
    "element",
    "weapon_type",
    "source"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "uk": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rarity": {
      "type": "integer",
      "enum": [
        4,
        5
      ]
    },
    "element": {
      "type": "string",
      "enum": [
        "aero",
        "electro",
        "fusion",
        "glacio",
        "havoc",
        "spectro"
      ]
    },
    "weapon_type": {
      "type": "string",
      "enum": [
        "broadblade",
        "gauntlets",
        "pistols",
        "rectifier",
        "sword"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "anyOf": [
        {
          "required": [
            "description"
          ]
        },
        {
          "required": [
            "max_level_stats"
          ]
        }
      ],
      "properties": {
        "description": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "max_level_stats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "hp",
            "attack",
            "defense"
          ],
          "properties": {
            "level": {
              "type": "integer",
              "const": 90
            },
            "hp": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "attack": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "defense": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "site",
            "page_url",
            "verified_at",
            "overview_revision_id",
            "stats_module_url",
            "stats_module_revision_id"
          ],
          "properties": {
            "site": {
              "type": "string",
              "const": "Wuthering Waves Wiki"
            },
            "page_url": {
              "type": "string",
              "format": "uri"
            },
            "verified_at": {
              "type": "string",
              "format": "date"
            },
            "overview_revision_id": {
              "type": "integer",
              "minimum": 1
            },
            "stats_module_url": {
              "type": "string",
              "format": "uri"
            },
            "stats_module_revision_id": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "convene_draw": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^characters/[a-z0-9]+(?:_[a-z0-9]+)*/convene_draw\\.png$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site",
        "verified_at",
        "page_last_updated"
      ],
      "properties": {
        "site": {
          "type": "string",
          "const": "Prydwen.gg"
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "page_last_updated": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "icon": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^characters/[a-z0-9]+(?:_[a-z0-9]+)*/icon\\.png$"
    },
    "full_sprite": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^characters/[a-z0-9]+(?:_[a-z0-9]+)*/full_sprite\\.png$"
    }
  }
}
