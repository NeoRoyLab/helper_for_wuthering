{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/NeoRoyLab/helper_for_wuthering/main/schema/weapon.schema.json",
  "title": "Wuthering Waves wiki weapon content record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "rarity", "weapon_type", "icon", "source"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": { "en": { "type": "string", "minLength": 1 } }
    },
    "rarity": { "type": "integer", "enum": [3, 4, 5] },
    "weapon_type": { "type": "string", "enum": ["broadblade", "gauntlets", "pistols", "rectifier", "sword"] },
    "icon": { "type": "string", "pattern": "^weapons/[a-z0-9]+(?:_[a-z0-9]+)*/icon\\.png$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "page_url", "verified_at", "revision_id"],
      "properties": {
        "site": { "type": "string", "const": "Wuthering Waves Wiki" },
        "page_url": { "type": "string", "pattern": "^https://wutheringwaves\\.fandom\\.com/wiki/" },
        "verified_at": { "type": "string", "format": "date" },
        "revision_id": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
